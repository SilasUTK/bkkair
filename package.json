{
  "name": "bkkair-visa-booking",
  "version": "1.0.0",
  "description": "BKK AIR - Visa Flight and Hotel Booking Support System",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix api-server install",
    "dev": "next dev",
    "dev:api": "npm --prefix api-server run dev",
    "build": "next build",
    "build:api": "npm --prefix api-server run build",
    "build:all": "npm run build && npm run build:api",
    "start": "next start",
    "start:api": "npm --prefix api-server run start",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "lint": "next lint"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.33",
    "postcss": "^8.5.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.33",
    "typescript": "^5.6.3"
  }
}

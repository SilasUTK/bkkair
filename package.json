{
  "name": "bkkair-visa-booking",
  "version": "1.0.0",
  "description": "BKK AIR - Visa Booking Support System (monorepo root)",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix frontend install && npm --prefix backend install",
    "dev": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "build:api": "npm --prefix backend run build",
    "build:all": "npm run build && npm run build:api",
    "start": "npm --prefix frontend run start",
    "start:api": "npm --prefix backend run start",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs"
  },
  "engines": {
    "node": "20.x"
  }
}

{
  "name": "bkkair-visa-booking",
  "version": "1.0.0",
  "description": "BKK AIR - Visa Flight and Hotel Booking Support System",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
      "test": "jest --passWithNoTests",
      "test:watch": "jest --watch",
      "test:coverage": "jest --coverage",
      "test:backend": "npm test --prefix backend",
      "test:frontend": "npm test",
      "test:all": "npm run test:backend && npm run test:frontend",
    "dev:api": "npm --prefix backend run dev",
    "build:api": "npm --prefix backend run build",
    "start:api": "npm --prefix backend run start",
    "install:backend": "npm --prefix backend install",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.7",
    "autoprefixer": "^10.5.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.33",
    "postcss": "^8.5.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

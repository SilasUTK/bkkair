{
  "name": "bkkair-visa-booking",
  "version": "1.0.0",
  "description": "BKK AIR - Visa Flight and Hotel Booking Support System",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:api": "npm --prefix backend run dev",
    "build:api": "npm --prefix backend run build",
    "start:api": "npm --prefix backend run start",
    "install:backend": "npm --prefix backend install",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "autoprefixer": "^10.5.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.33",
    "postcss": "^8.5.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "typescript": "^5.9.3"
  }
}
